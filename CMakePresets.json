{
    "version": 8,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 28
    },
    "configurePresets": [
        {
            "name": "debug",
            "displayName": "Build debug version",
            "binaryDir": "build",
            "description": "Build project in debug mode",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "BUILD_TESTING": "OFF"
            }
        },
        {
            "name": "debug-include-test",
            "displayName": "Build debug version with tests",
            "binaryDir": "build",
            "description": "Enable building in debug mode with tests",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "BUILD_TESTING": "ON"
            }
        },
        {
            "name": "release",
            "displayName": "Build release version",
            "binaryDir": "build",
            "description": "Build project in release mode",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "BUILD_TESTING": "OFF"
            }
        },
        {
            "name": "release-include-test",
            "displayName": "Build release version with tests",
            "binaryDir": "build",
            "description": "Enable building in release mode with tests",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "BUILD_TESTING": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug",
            "configurePreset": "debug"
        },
        {
            "name": "release",
            "configurePreset": "release"
        }
    ],
    "testPresets": [
        {
            "name": "debug",
            "configurePreset": "debug-include-test",
            "output": {"outputOnFailure": true}
        },
        {
            "name": "release",
            "configurePreset": "release-include-test",
            "output": {"outputOnFailure": true}
        }
    ]
}