<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <object class="GtkWindow" id="window">
    <property name="title">Particle Simulator</property>
    <property name="default-width">600</property>
    <property name="default-height">400</property>
    <child>
      <object class="GtkStack" id="stack_view_container">

      <!--Main menu view-->
        <child>
          <object class="GtkBox" id="main_menu_view">
            <property name="orientation">vertical</property>
            <property name="spacing">10</property>
            <property name="halign">center</property>
            <property name="valign">center</property>
            <child>
            <object class="GtkButton">
                <signal name="clicked" handler="main_menu_start_random_simulation_clicked"/>
                <property name="label">Simulación aleatoria</property>
            </object>
            </child>
            <child>
            <object class="GtkButton" id="main_menu_button_quit">
                <property name="label">Salir</property>
            </object>
            </child>
          </object>
        </child>

      <!--Random generation config view-->
        <child>
          <object class="AdwStatusPage" id="particle_generation_view_random_initialization">
            <property name="title">Generar particulas aleatoriamente</property>
            <child>
              <object class="GtkListBox">
                <!--SEED-->
                <child>
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">Semilla</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkSpinButton"></object>
                    </child>
                  </object>
                </child>

                <!--POSITIONS-->
                <child>
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">Posición máxima (exclusiva)</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkScale">
                        <property name="orientation">0</property>
                        <property name="width-request">130</property>
                        <property name="draw-value">true</property>
                        <property name="adjustment">
                          <object class="GtkAdjustment">
                            <property name="lower">0</property>
                            <property name="upper">1e5</property>
                            <property name="value">0</property>
                          </object>
                        </property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">Posición mínima (inclusiva)</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkScale">
                        <property name="orientation">0</property>
                        <property name="width-request">130</property>
                        <property name="draw-value">true</property>
                        <property name="adjustment">
                          <object class="GtkAdjustment">
                            <property name="lower">-1e5</property>
                            <property name="upper">0</property>
                            <property name="value">-1</property>
                          </object>
                        </property>
                      </object>
                    </child>
                  </object>
                </child>

                <!--VELOCITIES-->
                <child>
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">Velocidad máxima (exclusiva)</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkScale">
                        <property name="orientation">0</property>
                        <property name="width-request">130</property>
                        <property name="draw-value">true</property>
                        <property name="adjustment">
                          <object class="GtkAdjustment">
                            <property name="lower">0</property>
                            <property name="upper">1e5</property>
                            <property name="value">0</property>
                          </object>
                        </property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">Velocidad mínima (inclusiva)</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkScale">
                        <property name="orientation">0</property>
                        <property name="width-request">130</property>
                        <property name="draw-value">true</property>
                        <property name="adjustment">
                          <object class="GtkAdjustment">
                            <property name="lower">-1e5</property>
                            <property name="upper">0</property>
                            <property name="value">-1</property>
                          </object>
                        </property>
                      </object>
                    </child>
                  </object>
                </child>

                <!--MASSES-->
                <child>
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">Masa máxima (exclusiva)</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkScale">
                        <property name="orientation">0</property>
                        <property name="width-request">130</property>
                        <property name="draw-value">true</property>
                        <property name="adjustment">
                          <object class="GtkAdjustment">
                            <property name="lower">0</property>
                            <property name="upper">1e5</property>
                            <property name="value">0</property>
                          </object>
                        </property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">Masa mínima (inclusiva)</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkScale">
                        <property name="orientation">0</property>
                        <property name="width-request">130</property>
                        <property name="draw-value">true</property>
                        <property name="adjustment">
                          <object class="GtkAdjustment">
                            <property name="lower">-1e5</property>
                            <property name="upper">-1</property>
                            <property name="value">-1</property>
                          </object>
                        </property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      
      <!--Particle drawing view-->
      </object>
    </child>
  </object>
</interface>